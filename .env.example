# Copy to .env.local and fill in. Never commit .env.local.

# Postgres — POOLED connection string (transaction-mode pooler). Used by the app at runtime (prepare: false).
# Neon (via Vercel Storage) gives this as DATABASE_URL; Supabase: the port-6543 transaction pooler URL.
DATABASE_URL=

# Optional: direct / unpooled connection string, used only by drizzle-kit for migrations.
# Neon gives this as DATABASE_URL_UNPOOLED. If empty, migrations fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# LLM via OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=
LLM_MODEL=anthropic/claude-haiku-5.5

# Simulated "today" for all business date logic
SIM_TODAY=2026-10-15

# Demo persona display name
DEMO_USER_NAME=Fahad

# Chat messages allowed per session per hour
CHAT_RATE_LIMIT_PER_HOUR=30

# Chat messages allowed across ALL sessions per UTC day (protects the OpenRouter credit)
CHAT_GLOBAL_LIMIT_PER_DAY=500
